# backends/freebsd-be/Containerfile
#
# Immutablue on FreeBSD 15.1-RELEASE. Built on a FreeBSD host with podman +
# ocijail (scripts/check-backend.sh refuses anywhere else) from the official
# pkgbase OCI image; the shared build stages run through
# backends/lib/run-stages.sh with this backend's pkg/sysrc implementation.
# The result is not booted as a container: deliver.sh lays it into a ZFS boot
# environment.
#
# See backends/freebsd-be/backend.yaml for status; build host setup is in
# backends/freebsd-be/builder-vm.sh.
ARG BASE_IMAGE=ghcr.io/freebsd/freebsd-runtime
ARG BASE_IMAGE_TAG=15.1

FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG}

ARG FEDORA_VERSION=15.1
ARG IMAGE_TAG=immutablue:15.1-freebsd
ARG INSTALL_DIR=/usr/immutablue
ARG DO_INSTALL_AKMODS=false
ARG DO_INSTALL_ZFS=false
ARG DO_INSTALL_LTS=false
ARG IMMUTABLUE_BUILD=true
ARG IMMUTABLUE_BUILD_OPTIONS=${IMMUTABLUE_BUILD_OPTIONS}
ARG SKIP=
ARG DEPS_IMAGE
ARG BASE_IMAGE
ARG IMMUTABLUE_BACKEND=freebsd-be

# buildah on FreeBSD has no RUN --mount=type=bind, so the build context is
# COPY'd to /mnt-ctx (the path the stages expect) and deleted at the end; the
# Makefile builds this backend with --squash (backend.mk BACKEND_BUILD_FLAGS),
# so the copy leaves no layer behind.
COPY . /mnt-ctx

# The runtime image is only sh, rc and pkg: the stages need bash, (Go) yq and
# the base userland (cut, basename, find, ...). The pkgbase repository is
# enabled first and the whole base set installed here; stage 30 then adds the
# kernel, bootloader and the packages.yaml lists.
RUN mkdir -p /usr/local/etc/pkg/repos && \
    cp /mnt-ctx/backends/freebsd-be/overrides/usr/local/etc/pkg/repos/FreeBSD-base.conf /usr/local/etc/pkg/repos/ && \
    env ASSUME_ALWAYS_YES=yes pkg bootstrap -f && \
    pkg update -f && \
    pkg install -y FreeBSD-set-base bash go-yq && \
    { command -v yq > /dev/null || ln -s "$(command -v go-yq)" /usr/local/bin/yq; }

RUN /usr/local/bin/bash /mnt-ctx/backends/lib/run-stages.sh /mnt-ctx && \
    rm -rf /mnt-ctx

LABEL org.immutablue.backend=freebsd-be
