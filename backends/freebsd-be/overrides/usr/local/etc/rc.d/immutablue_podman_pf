#!/bin/sh
#
# PROVIDE: immutablue_podman_pf
# REQUIRE: FILESYSTEMS netif routing
# BEFORE: pf
# KEYWORD: nojail
#
# Networking for podman (freebsd-be). podman's default network is a bridge
# whose containers reach the outside through pf NAT; without pf every
# 'podman run' fails with "The pf kernel module must be loaded to support
# ipMasq networks". Before pf starts, this writes /etc/pf.conf from the rules
# podman ships (/usr/local/etc/containers/pf.conf.sample), with one NAT rule
# per network interface instead of the sample's single hard-coded one, so
# Ethernet, Wi-Fi and USB adapters all work, each translating to its own
# current address. It has no filter rules: pf passes everything else.
#
# The file is regenerated on every boot while its first line is the marker
# below. Delete that line to take /etc/pf.conf over; a pf.conf without the
# marker is never touched (add podman's rules to it yourself).
#
# It also mounts fdescfs on /dev/fd, which podman needs, and sets
# net.pf.filter_local=1 so ports published with -p answer on localhost too.
#
# Enable with: sysrc immutablue_podman_pf_enable=YES pf_enable=YES

# rc.subr is FreeBSD's rc(8) library; not something shellcheck can follow.
# shellcheck source=/dev/null
. /etc/rc.subr

name="immutablue_podman_pf"
rcvar="immutablue_podman_pf_enable"
start_cmd="${name}_start"
stop_cmd=":"

pf_conf="/etc/pf.conf"
marker="# Generated by rc.d/immutablue_podman_pf at boot; delete this line to keep your own edits."

# Interfaces traffic can leave by: everything but loopback and the virtual
# ones podman, pf and the Linuxulator create.
egress_ifs()
{
	for _if in $(ifconfig -l); do
		case "${_if}" in
			lo*|bridge*|cni-podman*|epair*|pflog*|pfsync*|enc*|gif*|stf*|vm-*) continue ;;
		esac
		echo "${_if}"
	done
}

immutablue_podman_pf_start()
{
	if ! mount -p | awk '$2 == "/dev/fd" { found = 1 } END { exit !found }'; then
		mount -t fdescfs fdesc /dev/fd
	fi
	sysctl -q net.pf.filter_local=1 > /dev/null

	if [ -e "${pf_conf}" ] && [ "$(head -n 1 "${pf_conf}")" != "${marker}" ]; then
		echo "immutablue_podman_pf: ${pf_conf} is not managed here; leaving it alone"
		return 0
	fi

	_tmp="$(mktemp "${pf_conf}.XXXXXX")"
	{
		echo "${marker}"
		echo "#"
		echo "# podman container NAT (from /usr/local/etc/containers/pf.conf.sample)."
		echo
		for _if in $(egress_ifs); do
			echo "nat on ${_if} inet from <cni-nat> to any -> (${_if})"
			echo "nat on ${_if} inet6 from <cni-nat> to !ff00::/8 -> (${_if})"
		done
		echo
		echo 'rdr-anchor "cni-rdr/*"'
		echo 'nat-anchor "cni-rdr/*"'
		echo "table <cni-nat>"
	} > "${_tmp}"
	chmod 0600 "${_tmp}"
	mv -f "${_tmp}" "${pf_conf}"
}

load_rc_config $name
: "${immutablue_podman_pf_enable:="NO"}"
run_rc_command "$1"
