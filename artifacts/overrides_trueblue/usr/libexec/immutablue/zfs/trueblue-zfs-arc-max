#!/bin/bash
set -euo pipefail

# Cap the ZFS ARC at half of system memory, leaving the rest for VMs and
# containers. zfs_arc_max is in bytes; /proc/meminfo's MemTotal is in KiB.
mem_total_kib="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
arc_max_bytes=$(( mem_total_kib * 1024 / 2 ))

echo "${arc_max_bytes}" > /sys/module/zfs/parameters/zfs_arc_max
