#!/bin/bash
# immutablue-snapshot - Snapshot the state an image update cannot roll back
#
# On a bootc/ostree system the image itself is already recoverable: the previous
# deployment stays on disk and `bootc rollback` returns to it, which covers /usr
# and the deployment's /etc. What it does NOT cover is /var, which is a separate
# btrfs subvolume holding system flatpaks, container storage, logs and machine
# state. An update mutates /var (flatpak, podman, brew) and nothing puts it back.
#
# This takes a read-only snapshot of /var before that happens, so a bad update
# can be undone completely rather than only partially. /home is deliberately not
# snapshotted: it is user data, an update does not touch it, and snapshotting it
# on every update would be expensive for no recovery benefit.
#
# Usage:
#   immutablue-snapshot create      Take a snapshot and prune old ones
#   immutablue-snapshot list        List existing snapshots
#   immutablue-snapshot prune       Prune to the configured retention only
#   immutablue-snapshot restore N   Stage snapshot N to become /var at next boot
#
# Options:
#   -h, --help     Show this help message
#   --license      Show license information
#
# Examples:
#   sudo immutablue-snapshot create
#   immutablue-snapshot list
#   sudo immutablue-snapshot prune
#   sudo immutablue-snapshot restore var-20260905T074400Z
#
# Settings (see immutablue-settings):
#   .immutablue.snapshot_before_update   enable/disable (default true)
#   .immutablue.snapshot_keep            how many to retain (default 5)
#
# Exit codes:
#   0 - Success, or skipped because the filesystem is unsupported
#   1 - Snapshot or restore failed
#   2 - Usage error

set -uo pipefail

if [[ -f /usr/libexec/immutablue/immutablue-header.sh ]]; then
    source /usr/libexec/immutablue/immutablue-header.sh
fi

VERSION="1.0.0"

# Subvolume that an image update mutates but ostree cannot restore.
#
# Overridable purely so the retention logic can be exercised against a scratch
# filesystem in tests; nothing in normal operation sets these.
SNAPSHOT_SOURCE="${IMMUTABLUE_SNAPSHOT_SOURCE:-/var}"

# Snapshots are kept under /sysroot because that is the real btrfs filesystem
# root; / is a composefs overlay of the deployment and cannot hold a subvolume.
SNAPSHOT_DIR="${IMMUTABLUE_SNAPSHOT_DIR:-/sysroot/immutablue-snapshots}"

SNAPSHOT_PREFIX="var"


show_help() {
    sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
}


show_license() {
    echo "immutablue-snapshot ${VERSION}"
    echo "Copyright (C) Zach Podbielniak"
    echo "License AGPLv3+: GNU AGPL version 3 or later <https://gnu.org/licenses/agpl.html>"
    echo "This is free software: you are free to change and redistribute it."
    echo "There is NO WARRANTY, to the extent permitted by law."
}


# Read a setting with a fallback, tolerating a missing immutablue-settings.
#
# param $1: the settings path
# param $2: the value to use when unset, null, or unreadable
settings_or_default() {
    if [[ $# -ne 2 ]]
    then
        echo '`settings_or_default()` requires 2 positional arguments'
        echo 'settings_or_default <path> <default>'
        exit 2
    fi

    local path="${1}"
    local fallback="${2}"
    local value

    value="$(immutablue-settings "${path}" 2>/dev/null)"
    if [[ -z "${value}" ]] || [[ "${value}" == "null" ]]
    then
        echo "${fallback}"
        return 0
    fi

    echo "${value}"
}


# Report the filesystem type backing the snapshot source.
detect_fs_type() {
    findmnt -no FSTYPE "${SNAPSHOT_SOURCE}" 2>/dev/null
}


# Create the snapshot.
#
# btrfs snapshots are copy-on-write, so this is effectively instant and costs
# no space until the two copies diverge. That is what makes it reasonable to do
# on every update.
create_snapshot() {
    local fs_type
    local stamp
    local target

    fs_type="$(detect_fs_type)"

    case "${fs_type}" in
        btrfs)
            ;;
        zfs)
            # ZFS root is not produced by any of the image-builder targets
            # (they all pass --rootfs btrfs), so this path is unreachable on a
            # stock install and is left unimplemented rather than guessed at.
            echo "NOTE: ${SNAPSHOT_SOURCE} is ZFS; snapshotting is not implemented for it"
            echo "NOTE: use 'zfs snapshot' directly, or a pre_update hook"
            return 0
            ;;
        "")
            echo "NOTE: cannot determine filesystem for ${SNAPSHOT_SOURCE}; skipping snapshot"
            return 0
            ;;
        *)
            echo "NOTE: ${SNAPSHOT_SOURCE} is ${fs_type}, not btrfs; skipping snapshot"
            return 0
            ;;
    esac

    if [[ "$(id -u)" != "0" ]]
    then
        echo "ERROR: creating a snapshot requires root" >&2
        return 1
    fi

    if [[ ! -d "${SNAPSHOT_DIR}" ]]
    then
        mkdir -p "${SNAPSHOT_DIR}" || return 1
    fi

    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    target="${SNAPSHOT_DIR}/${SNAPSHOT_PREFIX}-${stamp}"

    # -r makes the snapshot read-only, so it cannot be modified in place and
    # has to be restored deliberately.
    if ! btrfs subvolume snapshot -r "${SNAPSHOT_SOURCE}" "${target}"
    then
        echo "ERROR: failed to snapshot ${SNAPSHOT_SOURCE} to ${target}" >&2
        return 1
    fi

    echo "Snapshot created: ${target}"
    prune_snapshots
}


list_snapshots() {
    if [[ ! -d "${SNAPSHOT_DIR}" ]]
    then
        echo "No snapshots (${SNAPSHOT_DIR} does not exist)"
        return 0
    fi

    find "${SNAPSHOT_DIR}" -maxdepth 1 -name "${SNAPSHOT_PREFIX}-*" -printf '%f\n' 2>/dev/null | sort
}


# Delete the oldest snapshots beyond the retention count.
#
# Pruning is not optional housekeeping: a snapshot pins every extent the live
# subvolume later frees, so an unpruned series of /var snapshots will grow to
# hold every container image and flatpak ever deleted.
prune_snapshots() {
    local keep
    local snapshots
    local count
    local excess
    local name

    keep="$(settings_or_default .immutablue.snapshot_keep 5)"

    # A non-numeric or zero value would delete everything; refuse instead.
    if ! [[ "${keep}" =~ ^[0-9]+$ ]] || [[ "${keep}" -lt 1 ]]
    then
        echo "WARNING: .immutablue.snapshot_keep is '${keep}', expected a positive integer; using 5" >&2
        keep=5
    fi

    if [[ ! -d "${SNAPSHOT_DIR}" ]]
    then
        return 0
    fi

    mapfile -t snapshots < <(list_snapshots)
    count="${#snapshots[@]}"

    if [[ "${count}" -le "${keep}" ]]
    then
        return 0
    fi

    if [[ "$(id -u)" != "0" ]]
    then
        echo "ERROR: pruning snapshots requires root" >&2
        return 1
    fi

    excess=$(( count - keep ))

    # Names are timestamped, so sort order is age order.
    for name in "${snapshots[@]:0:${excess}}"
    do
        if btrfs subvolume delete "${SNAPSHOT_DIR}/${name}" >/dev/null
        then
            echo "Pruned old snapshot: ${name}"
        else
            echo "WARNING: could not prune ${name}" >&2
        fi
    done
}


# Stage a snapshot to become the live subvolume at the next boot.
#
# The live /var cannot simply be replaced while it is mounted and in use, so
# this does a rename swap at the btrfs top level instead:
#
#   1. mount the top level (subvolid=5), which is not normally mounted
#   2. take a WRITABLE snapshot of the chosen read-only snapshot
#   3. rename the current subvolume aside, keeping it
#   4. rename the new one into its place
#
# It works because /etc/fstab mounts /var by PATH (subvol=var), not by
# subvolid: the running system stays pinned to the old subvolume by id until
# reboot, and the next mount resolves the name to whatever now holds it.
#
# The old subvolume is renamed, never deleted. That is the whole safety model:
# if the restore turns out to be wrong, the previous state is still on disk and
# recovering it is another rename. It also means restores accumulate
# subvolumes, which is why they are reported at the end rather than cleaned up
# silently.
#
# param $1: the snapshot name, as shown by 'list'
# returns: 0 when staged, non-zero on any failure
restore_snapshot() {
    local name="$1"
    local source_path
    local device
    local subvol_name
    local top_level
    local stamp
    local staged
    local preserved

    if [[ -z "${name}" ]]
    then
        echo "ERROR: restore requires a snapshot name" >&2
        echo "       immutablue-snapshot list" >&2
        return 2
    fi

    source_path="${SNAPSHOT_DIR}/${name}"

    if [[ ! -d "${source_path}" ]]
    then
        echo "ERROR: no such snapshot: ${name}" >&2
        echo "       immutablue-snapshot list" >&2
        return 1
    fi

    # A directory that merely looks like a snapshot would produce a confusing
    # failure halfway through the swap, so confirm it really is a subvolume.
    if ! btrfs subvolume show "${source_path}" >/dev/null 2>&1
    then
        echo "ERROR: ${source_path} is not a btrfs subvolume" >&2
        return 1
    fi

    if [[ "$(id -u)" != "0" ]]
    then
        echo "ERROR: restoring a snapshot requires root" >&2
        return 1
    fi

    # The device is reported as '/dev/... [/var]'; the bracketed subvolume has
    # to come off before it can be mounted.
    device="$(findmnt -no SOURCE "${SNAPSHOT_SOURCE}" 2>/dev/null | sed 's/\[.*//')"
    subvol_name="$(findmnt -no OPTIONS "${SNAPSHOT_SOURCE}" 2>/dev/null \
        | tr ',' '\n' | sed -n 's/^subvol=\/\{0,1\}//p' | head -1)"

    if [[ -z "${device}" ]] || [[ -z "${subvol_name}" ]]
    then
        echo "ERROR: could not determine the device and subvolume for ${SNAPSHOT_SOURCE}" >&2
        return 1
    fi

    top_level="$(mktemp -d)"

    # subvolid=5 is the btrfs top level, where the named subvolumes (root, var,
    # home) actually live. It is deliberately not mounted in normal operation.
    if ! mount -o subvolid=5 "${device}" "${top_level}"
    then
        echo "ERROR: could not mount the btrfs top level from ${device}" >&2
        rmdir "${top_level}"
        return 1
    fi

    if [[ ! -d "${top_level}/${subvol_name}" ]]
    then
        echo "ERROR: subvolume '${subvol_name}' not found at the btrfs top level" >&2
        umount "${top_level}"; rmdir "${top_level}"
        return 1
    fi

    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    staged="${top_level}/${subvol_name}-immutablue-staged-${stamp}"
    preserved="${top_level}/${subvol_name}-immutablue-previous-${stamp}"

    # Writable, unlike the stored snapshot: this one becomes the live /var.
    if ! btrfs subvolume snapshot "${source_path}" "${staged}" >/dev/null
    then
        echo "ERROR: could not create a writable copy of ${name}" >&2
        umount "${top_level}"; rmdir "${top_level}"
        return 1
    fi

    # The dangerous window is between these two renames: if the second fails
    # there would be no subvolume under the expected name and the system would
    # not boot. Undo the first rather than leave it that way.
    if ! mv "${top_level}/${subvol_name}" "${preserved}"
    then
        echo "ERROR: could not move the current ${subvol_name} aside" >&2
        btrfs subvolume delete "${staged}" >/dev/null 2>&1 || true
        umount "${top_level}"; rmdir "${top_level}"
        return 1
    fi

    if ! mv "${staged}" "${top_level}/${subvol_name}"
    then
        echo "ERROR: could not move the restored copy into place; reverting" >&2
        if mv "${preserved}" "${top_level}/${subvol_name}"
        then
            echo "Reverted; the system is unchanged." >&2
        else
            echo "CRITICAL: ${subvol_name} is missing at the btrfs top level." >&2
            echo "CRITICAL: from a rescue shell, mount -o subvolid=5 ${device} /mnt" >&2
            echo "CRITICAL: then: mv /mnt/$(basename "${preserved}") /mnt/${subvol_name}" >&2
        fi
        btrfs subvolume delete "${staged}" >/dev/null 2>&1 || true
        umount "${top_level}"; rmdir "${top_level}"
        return 1
    fi

    umount "${top_level}"
    rmdir "${top_level}"

    echo "Staged ${name} as the new ${subvol_name}."
    echo "The previous ${subvol_name} is kept as ${subvol_name}-immutablue-previous-${stamp}"
    echo ""
    echo "Reboot to apply:  systemctl reboot"
    echo ""
    echo "To undo before rebooting, or from a rescue shell afterwards:"
    echo "  mount -o subvolid=5 ${device} /mnt"
    echo "  mv /mnt/${subvol_name} /mnt/${subvol_name}-discarded"
    echo "  mv /mnt/${subvol_name}-immutablue-previous-${stamp} /mnt/${subvol_name}"
}


main() {
    local action=""
    local target=""

    while [[ $# -gt 0 ]]
    do
        case "${1}" in
            -h|--help)
                show_help
                exit 0
                ;;
            --license)
                show_license
                exit 0
                ;;
            create|list|prune|restore)
                action="${1}"
                shift
                ;;
            *)
                # The only positional after an action is the snapshot name for
                # 'restore'; anything else is a usage error.
                if [[ "${action}" == "restore" ]] && [[ -z "${target}" ]]
                then
                    target="${1}"
                    shift
                else
                    echo "Unknown argument: ${1}" >&2
                    show_help
                    exit 2
                fi
                ;;
        esac
    done

    if [[ -z "${action}" ]]
    then
        show_help
        exit 2
    fi

    case "${action}" in
        create)
            create_snapshot
            ;;
        list)
            list_snapshots
            ;;
        prune)
            prune_snapshots
            ;;
        restore)
            restore_snapshot "${target}"
            ;;
    esac
}

main "$@"
